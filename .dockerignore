# Секреты и рабочие данные не попадают в образ: .env подключается через
# env_file, а data/ и backups/ — томами docker-compose.
.env
.env.*
!.env.example
data/
backups/
logs/
*.db
*.db-*
*.sqlite*

# Зависимости и сборки ставятся заново внутри образа под Linux.
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo

# Инструменты, IDE и служебные каталоги.
.git/
.github/
.idea/
.vscode/
.claude/
.agents/
.codebase-memory/
.tmpcheck/
coverage/

# Не нужно для запуска: корпус реплеев для бенчмарков, макеты редизайна, заметки.
benchmarks/
Редизайн игрового портала/
frontend/design/
*.md
