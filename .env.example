# Скопируй этот файл в .env и заполни значения

# Discord Developer Portal → Bot → Reset Token
TOKEN=

# Discord Developer Portal → General Information → Application ID
# Нужен для регистрации slash-команд (npm run deploy:commands)
CLIENT_ID=

# ID тестового сервера (ПКМ по серверу → «Копировать ID», нужен режим разработчика).
# Если задан — команды регистрируются мгновенно, но только на этом сервере.
# Если пуст — команды глобальные, Discord обновляет их до часа.
GUILD_ID=

# Порт веб-дашборда (по умолчанию 3000)
PORT=3000

# Путь к файлу SQLite (по умолчанию ./data/wtbot.db)
DB_PATH=./data/wtbot.db

# Ключ Claude API для анализа записей нейросетью (npm run analyze).
# Необязательно: без него всё остальное работает.
# Взять здесь: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=

# Голосовые каналы, за которыми следит бот (дашборд показывает, кто в них
# сидит, и статистику War Thunder по нику из серверного ника «WTНик (Имя)»).
# ID каналов через запятую (ПКМ по каналу → «Копировать ID», нужен режим
# разработчика). Пусто — отслеживаются все голосовые каналы серверов бота.
# WT_VOICE_CHANNELS=123456789012345678,234567890123456789

# Текстовый канал для автоанонса новых боёв: как только парсер приносит
# свежий реплей (опрос раз в 20 с), бот сам постит туда сообщение /battle
# с картинкой и кнопками. Пусто — автоанонс выключен.
# WT_BATTLES_CHANNEL=123456789012345678

# Клан-тег, бои которого анонсировать (например, WLILY). Пусто — анонсим все
# клановые бои. Сравнение по «ядру» тега без украшений и регистра, так что
# писать можно просто буквами: WLILY. Собираются и разбираются по-прежнему
# все бои (датасет полный) — фильтр только на том, что бот постит и показывает.
# WT_CLAN_TAG=WLILY

# Лимит кэша картинок боёв (data/battles) в МБ, по умолчанию 400. Это лишь
# кэш: все картинки перерисовываются из БД без реплея, поэтому при
# переполнении давно не открывавшиеся файлы удаляются. Меньше — экономнее
# по диску, но чаще пересборка картинок из БД.
# WT_BATTLE_CACHE_MB=400

# Повторно использовать готовые материалы боя из data/battles. При true
# рендерятся только новые бои и ранее вытесненные LRU наборы; успешная выдача
# обновляет время доступа. При false PNG/TXT строятся при каждом запросе, но
# новый результат всё равно сохраняется в этот каталог. По умолчанию true.
# WT_BATTLE_CACHE_ENABLED=true

# Настройки авиационной heatmap. Значения boolean: true/false, 1/0, yes/no
# или on/off. При изменении любой настройки старые PNG автоматически
# перестают считаться подходящими и будут пересобраны.
# WT_HEATMAP_AIR_AUTO_ZOOM=true
# WT_HEATMAP_AIR_SHOW_GROUND_MAP=true
# WT_HEATMAP_AIR_SHOW_AIRFIELDS=true
# WT_HEATMAP_AIR_SHOW_SPAWNS=true

# Свободное поле вокруг маршрутов при автоприближении, в процентах (0–50).
# WT_HEATMAP_AIR_PADDING_PERCENT=6

# Число CPU worker threads для разбора WRPL, zlib/zstd, больших JSON и PNG.
# По умолчанию min(2, число CPU - 1); допустимо 1–8. Два потока обычно
# дают лучший баланс отзывчивости Discord и памяти (Resvg/реплеи тяжёлые).
# WT_WORKER_THREADS=8

# Каталог установленной War Thunder — из её ui/fonts.vromfs.bin бот один раз
# достаёт фирменный шрифт (украшения клан-тегов ⚔/львы/пламя как в игре)
# и кладёт в data/fonts/. Необязательно: без указания бот сам ищет игру
# в библиотеках Steam и типовых путях Gaijin; если игры нет — украшения
# рисуются похожими юникод-символами. На сервер без игры можно просто
# скопировать data/fonts/symbols_skyquake.ttf с машины, где игра есть.
# WT_GAME_DIR=D:\SteamLibrary\steamapps\common\War Thunder

# Куки залогиненной сессии warthunder.com для парсера реплеев (wt-replays).
# Где взять: warthunder.com (войти в аккаунт) → F12 → Network → любой запрос
# к warthunder.com → Headers → cookie → скопируй identity_sid, _identity,
# _csrf, identity_id, identity_token одной строкой через «; ».
# Вставить достаточно ОДИН РАЗ: сервер продлевает сессию каждым ответом
# (+14 дней), бот подхватывает обновления и хранит актуальные куки
# в data/wt-cookies.json. Копировать из браузера заново нужно, только если
# бот простоял выключенным больше 14 дней или сессия отозвана (смена пароля) —
# тогда источник на дашборде станет красным с ошибкой «обнови WT_COOKIE».
WT_COOKIE=""
