# Скопируй этот файл в .env и заполни значения

# Discord Developer Portal → Bot → Reset Token
TOKEN=

# Discord Developer Portal → General Information → Application ID
# Нужен для регистрации slash-команд (npm run deploy:commands)
CLIENT_ID=

# ID тестового сервера (ПКМ по серверу → «Копировать ID», нужен режим разработчика).
# Если задан — команды регистрируются мгновенно, но только на этом сервере.
# Если пуст — команды глобальные, Discord обновляет их до часа.
GUILD_ID=

# Порт веб-дашборда (по умолчанию 3000)
PORT=3000

# Путь к файлу SQLite (по умолчанию ./data/wtbot.db)
DB_PATH=./data/wtbot.db

# Лениво получать account-статистику локально известных игроков со страницы
# профиля warthunder.com (тот же транспорт и cookie, что у wt-players).
# Запрос выполняется только после поиска на dashboard/API, последующий результат кэшируется на 24 часа.
# При false локальная статистика по собранным WRPL продолжает работать.
WT_PLAYER_STATS_ENABLED=true

# Дополнительный account-snapshot StatShark по известному WT user id.
# Использует тот же обычный Edge/CDP-профиль; Turnstile-token остаётся в браузере.
# Источник ленивый и по умолчанию выключен, чтобы не создавать массовые update-запросы.
STATSHARK_PLAYER_STATS_ENABLED=false

# Ники для автоматического сбора WT-профилей, статистики и реплеев через запятую.
# Пробелы по краям удаляются, повторяющиеся ники (без учёта регистра) игнорируются.
# Пример: WT_PLAYER_NAMES=ТУМ4Н,Venukbr
WT_PLAYER_NAMES=

# Ключ Claude API для анализа записей нейросетью (npm run analyze).
# Необязательно: без него всё остальное работает.
# Взять здесь: https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=

# Голосовые каналы, за которыми следит бот (дашборд и /playerboard показывают,
# кто в них сидит, и статистику War Thunder по нику «WTНик (Имя)»).
# ID каналов через запятую (ПКМ по каналу → «Копировать ID», нужен режим
# разработчика). Пусто — отслеживаются все голосовые каналы серверов бота.
# WT_VOICE_CHANNELS=123456789012345678,234567890123456789

# Текстовый канал для автоанонса новых боёв: как только парсер приносит
# свежий реплей (опрос раз в 20 с), бот сам постит туда сообщение /battle
# с картинкой и кнопками. Пусто — автоанонс выключен.
# WT_BATTLES_CHANNEL=123456789012345678

# Клан-тег, бои которого анонсировать (например, WLILY). Пусто — анонсим все
# клановые бои. Сравнение по «ядру» тега без украшений и регистра, так что
# писать можно просто буквами: WLILY. Собираются и разбираются по-прежнему
# все бои (датасет полный) — фильтр только на том, что бот постит и показывает.
# WT_CLAN_TAG=WLILY

# Лимит кэша картинок боёв (data/battles) в МБ, по умолчанию 400. Это лишь
# кэш: все картинки перерисовываются из БД без реплея, поэтому при
# переполнении давно не открывавшиеся файлы удаляются. Меньше — экономнее
# по диску, но чаще пересборка картинок из БД.
# WT_BATTLE_CACHE_MB=400

# Повторно использовать готовые материалы боя из data/battles. При true
# рендерятся только новые бои и ранее вытесненные LRU наборы; успешная выдача
# обновляет время доступа. При false PNG/TXT строятся при каждом запросе, но
# новый результат всё равно сохраняется в этот каталог. По умолчанию true.
# WT_BATTLE_CACHE_ENABLED=true

# Настройки авиационной heatmap. Значения boolean: true/false, 1/0, yes/no
# или on/off. При изменении любой настройки старые PNG автоматически
# перестают считаться подходящими и будут пересобраны.
# WT_HEATMAP_AIR_AUTO_ZOOM=true
# WT_HEATMAP_AIR_SHOW_GROUND_MAP=true
# WT_HEATMAP_AIR_SHOW_AIRFIELDS=true
# WT_HEATMAP_AIR_SHOW_SPAWNS=true

# Свободное поле вокруг маршрутов при автоприближении, в процентах (0–50).
# WT_HEATMAP_AIR_PADDING_PERCENT=6

# CPU pool для WRPL, zlib/zstd, больших JSON и PNG. По умолчанию auto:
# учитываются доступные логические CPU, свободная RAM и резервы ниже.
# Один CPU и один worker-slot остаются main thread, Discord и интерактиву.
# Число вместо auto полностью задаёт размер пула (не больше доступных CPU).
# WT_WORKER_THREADS=auto

# Сколько логических CPU не отдавать worker_threads (по умолчанию 1).
# WT_WORKER_RESERVE_CPUS=1

# RAM, которую auto-режим оставляет ОС/main thread, и оценка пика одного
# активного тяжёлого worker. По умолчанию резерв max(512 МБ, 15% RAM),
# оценка worker — 640 МБ.
# WT_WORKER_MEMORY_RESERVE_MB=2048
# WT_WORKER_ESTIMATED_MB=640

# Сколько готовых slots не занимать фоновым ingest (по умолчанию 1).
# Интерактивная карта Discord сможет стартовать без ожидания backlog.
# WT_WORKER_BACKGROUND_RESERVE=1

# Верхняя граница параллельности backlog. По умолчанию auto = worker threads
# минус интерактивный резерв; 1 возвращает строго последовательный ingest.
# WT_INGEST_CONCURRENCY=4

# Лимит old-space V8 каждого worker; native-память Resvg в него не входит.
# WT_WORKER_MAX_OLD_SPACE_MB=768

# Каталог установленной War Thunder — из её ui/fonts.vromfs.bin бот один раз
# достаёт фирменный шрифт (украшения клан-тегов ⚔/львы/пламя как в игре)
# и кладёт в data/fonts/. Необязательно: без указания бот сам ищет игру
# в библиотеках Steam и типовых путях Gaijin; если игры нет — украшения
# рисуются похожими юникод-символами. На сервер без игры можно просто
# скопировать data/fonts/symbols_skyquake.ttf с машины, где игра есть.
# WT_GAME_DIR=D:\SteamLibrary\steamapps\common\War Thunder

# Куки залогиненной сессии warthunder.com для wt-replays и wt-players.
# Где взять: warthunder.com (войти в аккаунт) → F12 → Network → любой запрос
# к warthunder.com → Headers → cookie → скопируй identity_sid, _identity,
# _csrf, identity_id, identity_token одной строкой через «; ».
# При Cloudflare 403 бот сам запустит настоящий Edge через локальный DevTools-порт.
# Копировать cf_clearance вручную не требуется; при первой интерактивной проверке
# пройди её в открывшемся окне, после чего браузерный профиль сохранит clearance.
# Вставить достаточно ОДИН РАЗ: сервер продлевает авторизационную сессию каждым ответом,
# бот подхватывает Set-Cookie и хранит auth-cookie в data/wt-cookies.json. Состояние
# Cloudflare хранится в браузерном профиле и не считается вечной cookie.
# Копировать из браузера заново нужно, только если
# бот простоял выключенным больше 14 дней или сессия отозвана (смена пароля) —
# тогда источник на дашборде станет красным с ошибкой «обнови WT_COOKIE».
WT_COOKIE=""

# Весь трафик warthunder.com идёт через настоящий Microsoft Edge: Cloudflare
# отклоняет прямые запросы из Node (403 cf-mitigated: challenge) даже со свежим
# cf_clearance, потому что клиренс привязан к TLS-отпечатку браузера.
# Auth-cookie по-прежнему живут в общем data/wt-cookies.json.
WT_BROWSER_ENABLED=true
# true — окно Edge уезжает за пределы экрана и не мешает. Настоящий headless
# Cloudflare не пропускает, поэтому окно всегда обычное. Если проверку не
# удалось пройти автоматически, окно само возвращается на экран для ручного
# прохождения.
WT_BROWSER_HEADLESS=true
# Максимальное ожидание проверки Cloudflare (15 000–180 000 мс).
# Автоматическое прохождение на чистом профиле занимает 8–10 секунд.
WT_BROWSER_TIMEOUT_MS=60000
# Профиль Edge, где сохраняется пройденная Cloudflare-проверка между запусками.
# Это не заменяет общий wt-cookies jar; профиль используется только браузером.
WT_BROWSER_PROFILE_DIR=./data/wt-browser-profile
# Сколько вкладок Edge обслуживают запросы параллельно (1–8).
WT_BROWSER_POOL_SIZE=3
# Порт DevTools Edge. 0 — взять свободный и запомнить его в профиле; так бот
# никогда не подключится к личному Edge пользователя. Задавайте ненулевой порт только
# если нужен фиксированный порт для отладки.
WT_BROWSER_CDP_PORT=0
# Необязательно: полный путь к Edge/Chromium. Без него используется канал msedge.
# WT_BROWSER_EXECUTABLE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
