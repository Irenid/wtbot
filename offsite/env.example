# Settings of the offsite backup (offsite.sh): copy to .env.offsite in the project (never committed)
# and turn it on with COMPOSE_PROFILES=offsite in .env.

# The restic repository on Google Drive, one folder per bot.
RESTIC_REPOSITORY=rclone:gdrive:backups/wtbot
# Encrypts everything before it leaves the host. Keep a copy off this host (a password manager):
# without it the backup cannot be read.
RESTIC_PASSWORD=
# An rclone Google Drive token, scope drive.file (it sees only the files rclone made): run
# `rclone config create gdrive drive scope=drive.file` where a browser is, then copy the JSON after
# `token = ` in ~/.config/rclone/rclone.conf, one line.
OFFSITE_DRIVE_TOKEN=
# rclone's shared Google app is being retired during 2026: make your own client ID
# (https://rclone.org/drive/#making-your-own-client-id, published: a Testing app's token dies in 7 days),
# then take OFFSITE_DRIVE_TOKEN from a remote made with it.
# RCLONE_DRIVE_CLIENT_ID=
# RCLONE_DRIVE_CLIENT_SECRET=
# Daily at this local time; a night missed catches up. After wtbot's own copy (WTBOT_BACKUP_TIME).
OFFSITE_TIME=05:30
TZ=UTC
# Optional: a Discord webhook URL (a staff channel), told once a day while the backup fails.
OFFSITE_DISCORD_WEBHOOK=
