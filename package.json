{
  "name": "wtbot",
  "version": "1.0.0",
  "description": "Discord-бот с веб-дашбордом и фоновыми парсерами",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:bot": "tsx watch src/index.ts --no-battle-background",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:web": "npm --prefix frontend run build",
    "dev:web": "npm --prefix frontend run dev",
    "start": "node dist/index.js",
    "start:bot": "node dist/index.js --no-battle-background",
    "deploy:commands": "tsx src/bot/deploy-commands.ts",
    "analyze": "tsx src/analysis/analyze-items.ts",
    "db:backup": "tsx src/analysis/db-backup.ts",
    "db:backup:schedule": "tsx src/analysis/db-backup-schedule.ts",
    "battle": "tsx src/analysis/battle-summary.ts",
    "scout:backtest": "tsx src/analysis/scout-backtest.ts",
    "scout:images": "tsx src/analysis/scout-images.ts",
    "capture:map": "tsx src/analysis/capture-map.ts",
    "backfill": "tsx src/parsers/backfill.ts",
    "site": "tsx src/analysis/site-real.ts",
    "test": "tsx --test --test-timeout=120000 \"src/**/*.test.ts\" \"src/**/*.spec.ts\"",
    "verify": "npm run typecheck && npm test && npm run verify:workers && npm run verify:site-db && npm run verify:site-api && npm run verify:player-stats && npm run verify:player-stats-provider && npm run verify:player-stats-api && npm run verify:player-board && npm run verify:player-board-voice && npm run verify:benchmark-corpus",
    "verify:wt-transport": "tsx src/analysis/wt-transport-smoke.ts",
    "verify:workers": "tsx src/analysis/worker-smoke.ts",
    "verify:workers:dist": "node dist/analysis/worker-smoke.js",
    "verify:player-stats": "tsx src/analysis/player-stats-smoke.ts",
    "verify:player-board": "tsx src/analysis/player-board-smoke.ts",
    "verify:player-board-voice": "tsx src/analysis/player-board-voice-smoke.ts",
    "verify:player-stats-provider": "tsx src/analysis/player-stats-provider-smoke.ts",
    "verify:player-stats-live": "tsx src/analysis/player-stats-live-smoke.ts",
    "verify:statshark-live": "tsx src/analysis/statshark-live-smoke.ts",
    "verify:player-stats-api": "tsx src/analysis/player-stats-api-smoke.ts",
    "verify:site-db": "tsx src/analysis/site-db-explain.ts",
    "verify:site-api": "tsx src/analysis/site-api-smoke.ts",
    "verify:benchmark-corpus": "tsx src/analysis/verify-benchmark-corpus.ts",
    "restore:benchmark-corpus": "tsx src/analysis/restore-benchmark-corpus.ts",
    "benchmark:ingest-telemetry": "tsx src/analysis/ingest-telemetry-benchmark.ts",
    "benchmark:sqlite-ingest": "tsx src/analysis/sqlite-ingest-benchmark.ts",
    "benchmark:performance-soak": "node dist/analysis/performance-soak.js",
    "benchmark:workers": "tsx src/analysis/worker-replay-check.ts",
    "benchmark:replay": "node --expose-gc --import tsx src/analysis/replay-download-benchmark.ts",
    "benchmark:voice": "tsx src/analysis/voice-api-benchmark.ts"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/static": "^10.1.4",
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.27.0",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.4",
    "fastify": "^5.10.0",
    "jpeg-js": "^0.4.4",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
